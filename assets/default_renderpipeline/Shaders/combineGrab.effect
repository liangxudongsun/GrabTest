CCEffect %{
techniques:
  - passes:
      - vert: combineGrab-vs
        frag: combineGrab-fs
        pass: combineGrab
        depthStencilState:
          depthTest: false
          depthWrite: false
}%


CCProgram combineGrab-vs %{
#include <./chunks/vs1>
}%

CCProgram combineGrab-fs %{
precision highp float;

layout(location = 0)out vec4 fragColor;
#pragma rate screenTex pass
uniform sampler2D screenTex;

#pragma rate grabTex pass
uniform sampler2D grabTex;

#pragma rate BufferBloomBlurMap pass
uniform sampler2D BufferBloomBlurMap;

in vec2 v_uv;
void main() {
    
   vec3 glassColor = texture(screenTex, v_uv).rgb;
   vec3 backgroundColor=texture(grabTex,v_uv).rgb;
   vec3 finalColor = 1.0 - (1.0 - backgroundColor) * (1.0 - glassColor);
 
    
    fragColor = vec4(finalColor.rgb, 1.0);
}
}%



