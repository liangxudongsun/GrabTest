CCEffect %{
techniques:
  - passes:
      - vert: myBlit-vs
        frag: myBlit-fs
        pass: myBlit
        depthStencilState:
          depthTest: false
          depthWrite: false
}%


CCProgram myBlit-vs %{
#include <./chunks/vs1>
}%

CCProgram myBlit-fs %{
precision highp float;

layout(location = 0)out vec4 fragColor;




// #pragma rate SpotShadowMap pass
// uniform sampler2D SpotShadowMap;

in vec2 v_uv;
void main() {

   //vec4 color=texture(SpotShadowMap,v_uv);
    
   
  
    
    fragColor = vec4(1.,0.,0.,1.);
}
}%



