CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: frosted-vs:vert
      frag: frosted-fs:frag
      phase: grab-caster
      depthStencilState:
        depthTest: true
        depthWrite: true
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
      rasterizerState:
        cullMode: back
      properties:
        frostTexture:  { value: white }
        frostIntensity: { value: 1.0, editor: { range: [0.0, 1.0] } }
}%

CCProgram frosted-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  out vec2 v_uv;
  out vec4 v_scrPos;

  vec4 vert() {
    vec4 position;
    CCVertInput(position);
    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    vec4 worldPos = matWorld * position;
    vec4 clipPos = cc_matProj * (cc_matView * worldPos);
    v_scrPos = clipPos;
    v_uv = a_texCoord;
    return clipPos;
  }
}%

CCProgram frosted-fs %{
  precision highp float;
  #include <legacy/output-standard>
  #include <builtin/uniforms/cc-global>

  uniform sampler2D frostTexture;

  uniform FrostedUniforms {
    float frostIntensity;
  };

  #pragma rate grabTex pass
  uniform sampler2D grabTex;
  #pragma rate blurTex0 pass
  uniform sampler2D blurTex0;
  #pragma rate blurTex1 pass
  uniform sampler2D blurTex1;
  #pragma rate blurTex2 pass
  uniform sampler2D blurTex2;
  #pragma rate blurTex3 pass
  uniform sampler2D blurTex3;

  in vec2 v_uv;
  in vec4 v_scrPos;

  vec4 frag() {
    vec2 screenUV = (v_scrPos.xy / v_scrPos.w) * 0.5 + 0.5;
    #if CC_EDITOR
      screenUV.y = 1.0 - screenUV.y;
    #endif

    float surfSmooth = 1.0 - texture(frostTexture, v_uv).x * frostIntensity;
    surfSmooth = clamp(surfSmooth, 0.0, 1.0);

    vec4 ref00 = texture(blurTex0, screenUV);
    vec4 ref01 = texture(blurTex1, screenUV);
    vec4 ref02 = texture(blurTex2, screenUV);
    vec4 ref03 = texture(blurTex3, screenUV);

    float step00 = smoothstep(0.75, 1.00, surfSmooth);
    float step01 = smoothstep(0.5, 0.75, surfSmooth);
    float step02 = smoothstep(0.05, 0.5, surfSmooth);
    float step03 = smoothstep(0.00, 0.05, surfSmooth);

    vec3 color = mix(ref03.rgb, mix(mix(mix(ref03.rgb, ref02.rgb, step02), ref01.rgb, step01), ref00.rgb, step00), step03);

    return CCFragOutput(vec4(color, 1.0));
  }
}%
