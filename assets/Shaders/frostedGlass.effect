CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: blur-vs:vert
      frag: blur-fs:frag
      phase: quad-caster
      depthStencilState:
        depthTest: false
        depthWrite: false
    - vert: frostedGlass-vs:vert
      frag: frostedGlass-fs:frag
      phase: frostedGlass-caster
      depthStencilState:
        depthTest: true
        depthWrite: true
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
      rasterizerState:
        cullMode: back
      properties:
        frostTexture:  { value: white }
        frostIntensity: { value: 1.0, editor: { range: [0.0, 1.0] } }
      
}%

CCProgram blur-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  #include <legacy/decode-base>
  #include <legacy/local-batch>
  #pragma rate blurUBO pass
  uniform blurUBO{
    vec4 BlurAmount;
  };
  out vec4 v_scrPos;
  vec4 vert() {
    vec4 position;
    CCVertInput(position);
    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    vec4 worldPos = matWorld * position;
    vec4 clipPos = cc_matProj * (cc_matView * worldPos);
    v_scrPos = clipPos;
    return clipPos;
  }
}%

CCProgram blur-fs %{
  precision highp float;
  #include <legacy/output-standard>
  #include <builtin/uniforms/cc-global>
  #pragma rate inputTex pass
  uniform sampler2D inputTex;
  #pragma rate blurUBO pass
  uniform blurUBO{
    vec4 BlurAmount;
  };
  in vec4 v_scrPos;

  

  vec4 frag() {
     vec2 uv =(v_scrPos.xy / v_scrPos.w) * 0.5 + 0.5;

    
    // 计算模糊采样偏移（原逻辑不变）
    vec4 uv01 = uv.xyxy + BlurAmount.xyxy * vec4(1., 1., -1., -1.);
    vec4 uv23 = uv.xyxy + BlurAmount.xyxy * vec4(1., 1., -1., -1.) * 2.;
    vec4 uv45 = uv.xyxy + BlurAmount.xyxy * vec4(1., 1., -1., -1.) * 3.;
   

    vec4 color = vec4(0.0,0.,0.,0.);
    color += 0.40 * texture(inputTex, uv);
    color += 0.15 * texture(inputTex, uv01.xy);
    color += 0.15 * texture(inputTex, uv01.zw);
    color += 0.10 * texture(inputTex, uv23.xy);
    color += 0.10 * texture(inputTex, uv23.zw);
    color += 0.05 * texture(inputTex, uv45.xy);
    color += 0.05 * texture(inputTex, uv45.zw);

    return vec4(color.rgb,1.);
  }
}%


CCProgram frostedGlass-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  out vec2 v_uv;
  out vec4 v_scrPos;

  vec4 vert() {
    vec4 position;
    CCVertInput(position);
    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    vec4 worldPos = matWorld * position;
    vec4 clipPos = cc_matProj * (cc_matView * worldPos);
    v_scrPos = clipPos;
    v_uv = a_texCoord;
    return clipPos;
  }
}%

CCProgram frostedGlass-fs %{
  precision highp float;
  #include <legacy/output-standard>
  #include <builtin/uniforms/cc-global>

  uniform sampler2D frostTexture;

  uniform FrostedUniforms {
    float frostIntensity;
  };

  #pragma rate grabTex pass
  uniform sampler2D grabTex;
  #pragma rate BlurMap20 pass
  uniform sampler2D BlurMap20;
  #pragma rate BlurMap21 pass
  uniform sampler2D BlurMap21;
  #pragma rate BlurMap22 pass
  uniform sampler2D BlurMap22;
  #pragma rate BlurMap23 pass
  uniform sampler2D BlurMap23;

  in vec2 v_uv;
  in vec4 v_scrPos;

  vec4 frag() {
    vec2 screenUV = (v_scrPos.xy / v_scrPos.w) * 0.5 + 0.5;

    float surfSmooth = 1.0 - texture(frostTexture, v_uv).x * frostIntensity;
    surfSmooth = clamp(surfSmooth, 0.0, 1.0);
    
    vec4 ref00 = texture(BlurMap20, screenUV);
    vec4 ref01 = texture(BlurMap21, screenUV);
    vec4 ref02 = texture(BlurMap22, screenUV);
    vec4 ref03 = texture(BlurMap23, screenUV);

    float step00 = smoothstep(0.75, 1.00, surfSmooth);
    float step01 = smoothstep(0.5, 0.75, surfSmooth);
    float step02 = smoothstep(0.05, 0.5, surfSmooth);
    float step03 = smoothstep(0.00, 0.05, surfSmooth);
//return lerp(ref03, lerp(lerp(lerp(ref03, ref02, step02), ref01, step01), ref00, step00), step03);
    vec4 color = mix(ref03, mix(mix(mix(ref03, ref02, step02), ref01, step01), ref00, step00), step03);
    vec4 grabColor=texture(grabTex,  gl_FragCoord.xy * cc_screenSize.zw);
    return CCFragOutput(color);
  }
}%


CCProgram sceneBloom-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  out vec2 v_uv;
  out vec4 v_scrPos;

  vec4 vert() {
    vec4 position;
    CCVertInput(position);
    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    vec4 worldPos = matWorld * position;
    vec4 clipPos = cc_matProj * (cc_matView * worldPos);
    v_scrPos = clipPos;
    v_uv = a_texCoord;
    return clipPos;
  }
}%

CCProgram sceneBloom-fs %{
  precision highp float;
  #include <legacy/output-standard>
  #include <builtin/uniforms/cc-global>

  uniform sampler2D frostTexture;
  #pragma rate sceneBloomUBO pass
  uniform sceneBloomUBO{
      vec4  bloomTint;
      float threshold;
      float intensity;
  };
  #pragma rate grabTex pass
  uniform sampler2D grabTex;
  in vec2 v_uv;
  in vec4 v_scrPos;

  vec4 frag() {
    vec2 screenUV = (v_scrPos.xy / v_scrPos.w) * 0.5 + 0.5;
    
    
    vec4 color = texture(grabTex, screenUV);
    float brightness = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));
    if (brightness > threshold) {
        return color * (brightness - threshold) * intensity*bloomTint;
    }
    return color*bloomTint;
  }
}%