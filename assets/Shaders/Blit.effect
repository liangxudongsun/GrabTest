CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: bufferBloom-vs:vert
      frag: bufferBloom-fs:frag
      phase: bufferBloomBlur-caster
      depthStencilState:
        depthTest: false
        depthWrite: false
    - vert: bufferBloomCombine-vs:vert
      frag: bufferBloomCombine-fs:frag
      phase: bufferBloomCombine-caster
      depthStencilState:
        depthTest: false
        depthWrite: false

  
}%

CCProgram bufferBloom-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-local>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>
  
  out vec2 v_uv;
  out vec4 v_scrPos;
  
  vec4 vert () {
    vec4 position;
    CCVertInput(position);
    
    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    vec4 worldPos = matWorld * position;
    
    v_scrPos = cc_matView * worldPos;
    v_scrPos = cc_matProj * v_scrPos;
    v_uv = a_texCoord;
    
    return v_scrPos;
  }
}%

CCProgram bufferBloom-fs %{
  precision highp float;
  #include <legacy/output-standard>
  #include <builtin/uniforms/cc-global>
  
  #pragma rate bloomMap pass
  uniform sampler2D bloomMap;
  
  in vec2 v_uv;
  in vec4 v_scrPos;
  
  vec3 makeBloom(float lod, vec2 offset, vec2 bCoord, float resolutionX, float resolutionY) {
    vec2 pixelSize = cc_screenSize.zw; // 已经等于 1/width, 1/height
    offset += pixelSize;
    float lodFactor = exp2(lod);
    vec3 bloom = vec3(0.0);
    vec2 scale = lodFactor * pixelSize;
    
    vec2 coord = (bCoord.xy - offset) * lodFactor;
    float totalWeight = 0.0;
    
    if (any(greaterThanEqual(abs(coord - 0.5), scale + 0.5))) {
      return vec3(0.0);
    }
    
    for (int i = -5; i < 5; i++) {
      for (int j = -5; j < 5; j++) {
        float wg = pow(1.0 - length(vec2(float(i), float(j))) * 0.125, 6.0);
        
        vec2 texCoord = vec2(float(i), float(j)) * scale + lodFactor * pixelSize + coord;
        bloom += pow(texture(bloomMap, texCoord).rgb, vec3(2.2)) * wg;
        totalWeight += wg;
      }
    }
    
    bloom /= totalWeight;
    return bloom;
  }
  
  vec4 frag () {
    vec2 uv = (v_scrPos.xy / v_scrPos.w) * 0.5 + 0.5;
    vec2 resolution = vec2(1920., 1080.);
    
    vec3 blur = makeBloom(2.0, vec2(0.0, 0.0), uv, resolution.x, resolution.y);
    blur += makeBloom(3.0, vec2(0.3, 0.0), uv, resolution.x, resolution.y);
    blur += makeBloom(4.0, vec2(0.0, 0.3), uv, resolution.x, resolution.y);
    blur += makeBloom(5.0, vec2(0.1, 0.3), uv, resolution.x, resolution.y);
    blur += makeBloom(6.0, vec2(0.2, 0.3), uv, resolution.x, resolution.y);
    
    vec3 result = pow(blur, vec3(1.0 / 2.2));
    
    return vec4(result, 1.0);
  }
}%

CCProgram bufferBloomCombine-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-local>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>
  
  out vec2 v_uv;
  out vec4 v_scrPos;
  
  vec4 vert () {
    vec4 position;
    CCVertInput(position);
    
    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    vec4 worldPos = matWorld * position;
    
    v_scrPos = cc_matView * worldPos;
    v_scrPos = cc_matProj * v_scrPos;
    v_uv = a_texCoord;
    
    return v_scrPos;
  }
}%

CCProgram bufferBloomCombine-fs %{
  precision highp float;
  #include <legacy/output-standard>
  #include <builtin/uniforms/cc-global>
  
  #define COLOR_RANGE 12.0
  
  #pragma rate bloomMap pass
  uniform sampler2D bloomMap;
  
  #pragma rate bloomBlurMap pass
  uniform sampler2D bloomBlurMap;

  #pragma rate FrameMap pass
  uniform sampler2D FrameMap;


  

  
  in vec2 v_uv;
  in vec4 v_scrPos;
  
  vec3 jodieReinhardTonemap(vec3 c) {
    float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
    vec3 tc = c / (c + 1.0);
    return mix(c / (l + 1.0), tc, tc);
  }
  
  vec3 bloomTile(float lod, vec2 offset, vec2 uv) {
    return texture(bloomBlurMap, uv * exp2(-lod) + offset).rgb;
  }
  
  vec3 getBloom(vec2 uv) {
    vec3 blur = vec3(0.0);
    
    blur = pow(bloomTile(2., vec2(0.0, 0.0), uv), vec3(2.2)) + blur;
    blur = pow(bloomTile(3., vec2(0.3, 0.0), uv), vec3(2.2)) * 1.3 + blur;
    blur = pow(bloomTile(4., vec2(0.0, 0.3), uv), vec3(2.2)) * 1.6 + blur;
    blur = pow(bloomTile(5., vec2(0.1, 0.3), uv), vec3(2.2)) * 1.9 + blur;
    blur = pow(bloomTile(6., vec2(0.2, 0.3), uv), vec3(2.2)) * 2.2 + blur;
    
    return blur * COLOR_RANGE;
  }
  
  vec4 frag () {
    vec2 uv = (v_scrPos.xy / v_scrPos.w) * 0.5 + 0.5;
    vec3 color = pow(texture(bloomMap, uv).rgb * COLOR_RANGE, vec3(2.2));
    color = pow(color, vec3(2.2));
    color += pow(getBloom(uv), vec3(2.2));
    color = pow(color, vec3(1.0 / 2.2));
    float alpha=1.;
    color = jodieReinhardTonemap(color);

    vec3 grabColor=texture(FrameMap,uv).rgb;

    vec3 finalColor=1.-(1.-grabColor)*(1.-color);
   

    

    
    return vec4(finalColor, 1.);
  }
}%



CCProgram depthCopy-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-local>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>
  
  out vec2 v_uv;
  out vec4 v_scrPos;
  
  vec4 vert () {
    vec4 position;
    CCVertInput(position);
    
    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    vec4 worldPos = matWorld * position;
    
    v_scrPos = cc_matView * worldPos;
    v_scrPos = cc_matProj * v_scrPos;
    v_uv = a_texCoord;
    
    return v_scrPos;
  }
}%

CCProgram depthCopy-fs %{
  precision highp float;
  #include <legacy/output-standard>
  #include <builtin/uniforms/cc-global>  
  #pragma rate depthTex pass
  uniform sampler2D depthTex;
  in vec2 v_uv;
  in vec4 v_scrPos;
  vec4 frag () {
    vec2 uv = (v_scrPos.xy / v_scrPos.w) * 0.5 + 0.5;
    float d =texture(depthTex,uv).r;
    return vec4(d,d,d, 1.0);
  }
}%

CCProgram screenCopy-fs %{
  precision highp float;
  #include <legacy/output-standard>
  #include <builtin/uniforms/cc-global>  
  #pragma rate grabTex pass
  uniform sampler2D grabTex;
  in vec2 v_uv;
  in vec4 v_scrPos;
  vec4 frag () {
    vec2 uv = (v_scrPos.xy / v_scrPos.w) * 0.5 + 0.5;
    vec4 color=texture(grabTex,uv);
    return color;
  }
}%